load("@rules_cc//cc:defs.bzl", "cc_library")
load("@aspect_rules_lint//format:defs.bzl", "format_multirun")
load("//:linters.bzl", "clang_tidy_test")

exports_files([".clang-tidy", "system_prompt.md"])

alias(
    name = "std_slop",
    actual = "//app:std_slop",
)

cc_library(
    name = "core_api",
    visibility = ["//visibility:public"],
    deps = ["//core:api"],
)

cc_library(
    name = "tools_api",
    visibility = ["//visibility:public"],
    deps = ["//tools:api"],
)

cc_library(
    name = "app_api",
    visibility = ["//visibility:public"],
    deps = ["//interface:app_api"],
)

sh_binary(
    name = "clang_format_hermetic",
    srcs = ["//scripts:clang_format_wrapper.sh"],
    data = ["@llvm_toolchain//:clang-format"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
    visibility = ["//visibility:public"], 
)

sh_binary(
    name = "clang_tidy_hermetic",
    srcs = ["//scripts:clang_tidy_wrapper.sh"],
    data = ["@llvm_toolchain//:clang-tidy"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
    visibility = ["//visibility:public"], 
)

format_multirun(
    name = "format",
    cc = ":clang_format_hermetic",
    disable_git_attribute_checks = True,
)

clang_tidy_test(
    name = "clang_tidy_test",
    srcs = [
        "//core:api",
        "//tools:api",
        "//interface",
        ":std_slop",
    ],
)

sh_binary(
    name = "fix",
    testonly = True,
    srcs = ["//scripts:fix.sh"],
    data = [
        "//scripts:clang_tidy_fix.sh",
        ":format",
        ":clang_tidy_test",
    ],
)

sh_binary(
    name = "clang_tidy_fix",
    testonly = True,
    srcs = ["//scripts:clang_tidy_fix.sh"],
    data = [
        ":clang_tidy_test",
    ],
)




