load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@aspect_rules_lint//format:defs.bzl", "format_test")

format_test(
    name = "format_test",
    cc = "//:clang_format_hermetic",
    srcs = glob(["*.cpp", "*.h"]),
)

cc_library(
    name = "config",
    srcs = ["config.cpp"],
    hdrs = ["config.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//core:json_utils",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "config_test",
    srcs = ["config_test.cpp"],
    deps = [
        ":config",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_library(
    name = "client",
    srcs = ["client.cpp"],
    hdrs = ["client.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        "//core:json_utils",
        "//core:transport",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "client_test",
    srcs = ["client_test.cpp"],
    deps = [
        ":client",
        "//core:transport",
        "@abseil-cpp//absl/time",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "client_fuzz_test",
    srcs = ["client_fuzz_test.cpp"],
    copts = ["-Wno-deprecated-declarations", "-Wno-unused-parameter"],
    deps = [
        ":client",
        "//core:json_utils",
        "@fuzztest//fuzztest",
        "@fuzztest//fuzztest:fuzztest_gtest_main",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "config_fuzz_test",
    srcs = ["config_fuzz_test.cpp"],
    copts = ["-Wno-deprecated-declarations", "-Wno-unused-parameter"],
    deps = [
        ":config",
        "@abseil-cpp//absl/status",
        "@fuzztest//fuzztest",
        "@fuzztest//fuzztest:fuzztest_gtest_main",
        "@googletest//:gtest",
    ],
)
