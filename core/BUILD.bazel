[
 cc_test(
 name = test_name,
 srcs = [test_name + ".cpp"],
 copts = [
 "-DSQLITE_ENABLE_COLUMN_METADATA",
 "-DSQLITE_ENABLE_FTS5",
 ],
 env = {
 "SLOP_SKIP_STAGING_CHECK": "1",
 },
 deps = [
 ":api",
 ":shell_lib",
 ":cancellation",
 "//tools:runtime",
 "//tools:dispatcher",
 "//interface:ui",
 "//interface:color",
 "@sqlite3//:sqlite3",
 "@googletest//:gtest_main",
 "@nlohmann_json//:json",
 "@abseil-cpp//absl/status",],
 )
 for test_name in [
 "database_test",
 "http_client_test",
 "openai_utils_test",
 "orchestrator_test",
 "orchestrator_openai_test",
 "orchestrator_openai_responses_test",
 "tool_executor_test",
