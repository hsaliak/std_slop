)

[
    cc_test(
        name = test_name,
        srcs = [test_name + ".cpp"],
        deps = [
            ":interface",
            ":interaction_engine",
            "//core:api",
            "@googletest//:gtest_main",
        ],
    )
    for test_name in [
        "command_handler_test",
        "ui_test",
        "input_parsing_test",
        "completer_test",
        "context_management_test",
        "interaction_engine_test",
    ]
]

