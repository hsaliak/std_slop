load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@aspect_rules_lint//format:defs.bzl", "format_test")



format_test(
    name = "format_test",
    cc = "//:clang_format_hermetic",
    srcs = glob(["*.cpp", "*.h"]),
)

cc_library(
    name = "color",
    hdrs = ["color.h"],
#    includes = [".."],
    visibility = ["//visibility:public"],
)

