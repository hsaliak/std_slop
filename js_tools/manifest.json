  {
    "name": "git_grep",
    "description": "Preferred tool for codebase search; supports explicit result modes ('matches'|'files'|'count') with structured or raw output.",
    "json_schema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "string"
        },
        "paths": {
          "type": "array",
          "description": "array of pathspec strings (optional)",
          "items": {
            "type": "string"
          }
        },
        "fixed": {
          "type": "boolean",
          "description": "boolean (optional, uses -F)"
        },
        "functionContext": {
          "type": "boolean",
          "description": "boolean (optional, uses -W)"
        },
        "ignoreCase": {
          "type": "boolean",
          "description": "boolean (optional, uses -i)"
        },
        "cwd": {
          "type": "string",
          "description": "string (optional, run from this directory)"
        },
        "format": {
          "type": "string",
          "description": "string (optional, 'structured' or 'raw', default 'structured')"
        },
        "mode": {
          "type": "string",
          "description": "string (optional, 'matches'|'files'|'count'; default 'matches')"
        }
      },
      "required": [
        "pattern"
      ]
    },
    "implementation": "git_grep.js"
  },
