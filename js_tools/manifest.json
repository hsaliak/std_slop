[
  {
    "name": "apply_patch",
    "description": "Applies a unified diff to a file. The diff should be a valid unified diff string. Note: When passing the diff in JSON/JS, ensure newlines are escaped as \\n and backslashes as \\\\.",
    "json_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The path to the file to be patched."
        },
        "unified_diff": {
          "type": "string",
          "description": "The unified diff content to apply."
        },
        "dry_run": {
          "type": "boolean",
          "description": "If true, only check if the patch can be applied without modifying the file."
        },
        "strip": {
          "type": "integer",
          "description": "The number of leading components to strip from file names (-p argument)."
        },
        "fuzz": {
          "type": "integer",
          "description": "The maximum fuzz factor (-F argument)."
        },
        "ignore_whitespace": {
          "type": "boolean",
          "description": "If true, ignore changes in whitespace (-l argument)."
        }
      },
      "required": [
        "path",
        "unified_diff"
      ]
    },
    "implementation": "apply_patch.js"
  },
